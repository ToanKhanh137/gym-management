# ===========================
# Root-level .gitignore
# Bao phủ cả backend/ và frontend/
# ===========================

# ===========================
# Dependencies
# ===========================
**/node_modules/
node_modules/

# ===========================
# Environment & Secrets
# ===========================
**/.env
**/.env.local
**/.env.*.local
.env
.env.local
.env.*.local

# ===========================
# Database (SQLite)
# ===========================
**/*.db
**/*.db-journal
**/*.db-shm
**/*.db-wal

# ===========================
# Build output
# ===========================
**/dist/
**/build/

# ===========================
# Logs
# ===========================
logs/
**/logs/
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ===========================
# OS & System files
# ===========================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
# Windows
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
desktop.ini
$RECYCLE.BIN/
# Linux
*~

# ===========================
# IDE & Editor
# ===========================
# VS Code
.vscode/
!.vscode/extensions.json     # Cho phép commit extensions.json nếu cần

# JetBrains (IntelliJ, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr

# Eclipse
.classpath
.project
.settings/

# Vim / Emacs
*.swp
*.swo
*.swn
*.suo
*~

# Sublime Text
*.sublime-workspace
*.sublime-project

# ===========================
# Package manager locks
# (giữ lại package-lock.json, bỏ những cái khác)
# ===========================
yarn.lock
pnpm-lock.yaml
.pnp
.pnp.js

# ===========================
# Testing
# ===========================
coverage/
**/coverage/
.nyc_output/

# ===========================
# Caches
# ===========================
.npm
.eslintcache
.cache/
**/.cache/
.parcel-cache/
.temp/
tmp/
