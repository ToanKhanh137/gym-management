// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   // "owner" | "staff" | "pt" | "member"
  phone        String?
  dob          String?  // stored as ISO date string
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  member              Member?
  trainer             Trainer?
  feedbacksGiven      Feedback[]        @relation("FeedbackGiver")
  maintenanceReported MaintenanceRequest[] @relation("Reporter")
  maintenanceResolved MaintenanceRequest[] @relation("Resolver")
  trainingLogsRecorded TrainingLog[]    @relation("RecordedBy")
  subscriptionsCreated Subscription[]  @relation("CreatedBy")
  subscriptionRenewals SubscriptionRenewal[] @relation("RenewedBy")
  feedbacksResolved    Feedback[]       @relation("FeedbackResolver")
  staffSchedules       StaffSchedule[]

  @@map("users")
}

model Member {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique @map("user_id")
  memberCode   String   @unique @map("member_code")
  occupation   String?
  createdAt    DateTime @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id])
  subscriptions Subscription[]
  trainingLogs  TrainingLog[]
  feedbacks     Feedback[]     @relation("FeedbackSender")

  @@map("members")
}

model Trainer {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique @map("user_id")
  speciality String?
  createdAt  DateTime @default(now()) @map("created_at")

  user          User              @relation(fields: [userId], references: [id])
  schedules     TrainerSchedule[]
  subscriptions Subscription[]

  @@map("trainers")
}

model TrainerSchedule {
  id        Int    @id @default(autoincrement())
  trainerId Int    @map("trainer_id")
  dayOfWeek Int    // 0=Sun, 1=Mon, ...
  startTime String // "08:00"
  endTime   String // "17:00"

  trainer Trainer @relation(fields: [trainerId], references: [id])

  @@map("trainer_schedules")
}

model MembershipPackage {
  id           Int      @id @default(autoincrement())
  name         String
  type         String   // "per_session" | "monthly" | "quarterly" | "yearly" | "vip" | "pt"
  durationDays Int?     @map("duration_days")   // null for per_session
  totalSessions Int?    @map("total_sessions")  // for per_session
  price        Float
  description  String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  subscriptions Subscription[]

  @@map("membership_packages")
}

model Subscription {
  id            Int      @id @default(autoincrement())
  memberId      Int      @map("member_id")
  packageId     Int      @map("package_id")
  startDate     String   @map("start_date")   // ISO date
  endDate       String?  @map("end_date")     // null for per_session only
  sessionsTotal Int?     @map("sessions_total")
  sessionsUsed  Int      @default(0) @map("sessions_used")
  status        String   @default("active")   // "active" | "expired" | "cancelled"
  paymentMethod String   @map("payment_method") // "cash" | "bank_transfer" | "e_wallet"
  amountPaid    Float    @map("amount_paid")
  paidAt        DateTime @map("paid_at")
  createdById   Int      @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  trainerId     Int?     @map("trainer_id")

  member      Member            @relation(fields: [memberId], references: [id])
  package     MembershipPackage @relation(fields: [packageId], references: [id])
  createdBy   User              @relation("CreatedBy", fields: [createdById], references: [id])
  trainer     Trainer?          @relation(fields: [trainerId], references: [id])
  trainingLogs TrainingLog[]
  renewals     SubscriptionRenewal[]

  @@map("subscriptions")
}

model SubscriptionRenewal {
  id              Int      @id @default(autoincrement())
  subscriptionId  Int      @map("subscription_id")
  previousEndDate String?  @map("previous_end_date")
  newEndDate      String?  @map("new_end_date")
  addedSessions   Int?     @map("added_sessions")
  paymentMethod   String   @map("payment_method")
  amountPaid      Float    @map("amount_paid")
  renewedById     Int      @map("renewed_by_id")
  renewedAt       DateTime @default(now()) @map("renewed_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  renewedBy    User         @relation("RenewedBy", fields: [renewedById], references: [id])

  @@map("subscription_renewals")
}

model Room {
  id        Int      @id @default(autoincrement())
  roomCode  String   @unique @map("room_code")
  name      String
  type      String   // "gym" | "yoga" | "fitness" | "other"
  capacity  Int?
  status    String   @default("active") // "active" | "inactive" | "maintenance"
  createdAt DateTime @default(now()) @map("created_at")

  equipment Equipment[]

  @@map("rooms")
}

model Equipment {
  id           Int      @id @default(autoincrement())
  roomId       Int?     @map("room_id")
  equipmentCode String  @unique @map("equipment_code")
  name         String
  quantity     Int      @default(1)
  importedAt   String?  @map("imported_at")
  warrantyUntil String? @map("warranty_until")
  origin       String?
  status       String   @default("good") // "good" | "damaged" | "maintenance" | "retired"
  createdAt    DateTime @default(now()) @map("created_at")

  room               Room?               @relation(fields: [roomId], references: [id])
  maintenanceRequests MaintenanceRequest[]

  @@map("equipment")
}

model MaintenanceRequest {
  id           Int      @id @default(autoincrement())
  equipmentId  Int      @map("equipment_id")
  reportedById Int      @map("reported_by_id")
  description  String
  status       String   @default("pending") // "pending" | "in_progress" | "resolved"
  reportedAt   DateTime @default(now()) @map("reported_at")
  resolvedAt   DateTime? @map("resolved_at")
  resolvedById Int?     @map("resolved_by_id")

  equipment  Equipment @relation(fields: [equipmentId], references: [id])
  reportedBy User      @relation("Reporter", fields: [reportedById], references: [id])
  resolvedBy User?     @relation("Resolver", fields: [resolvedById], references: [id])

  @@map("maintenance_requests")
}

model TrainingLog {
  id             Int      @id @default(autoincrement())
  memberId       Int      @map("member_id")
  subscriptionId Int      @map("subscription_id")
  checkedInAt    DateTime @default(now()) @map("checked_in_at")
  checkedOutAt   DateTime? @map("checked_out_at")
  recordedById   Int      @map("recorded_by_id")
  notes          String?

  member       Member       @relation(fields: [memberId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  recordedBy   User         @relation("RecordedBy", fields: [recordedById], references: [id])

  @@map("training_logs")
}

model Feedback {
  id          Int      @id @default(autoincrement())
  memberId    Int      @map("member_id")
  targetType  String   @map("target_type") // "staff" | "facility" | "pt"
  targetId    Int?     @map("target_id")   // FK to users or rooms
  rating      Int      // 1–5
  comment      String?
  status       String    @default("pending")
  response     String?
  resolvedAt   DateTime? @map("resolved_at")
  resolvedById Int?      @map("resolved_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  member Member @relation("FeedbackSender", fields: [memberId], references: [id])
  givenBy    User? @relation("FeedbackGiver", fields: [targetId], references: [id])
  resolvedBy User? @relation("FeedbackResolver", fields: [resolvedById], references: [id])

  @@map("feedbacks")
}

model StaffSchedule {
  id        Int    @id @default(autoincrement())
  userId    Int    @map("user_id")
  dayOfWeek Int    @map("day_of_week")
  startTime String  @map("start_time")
  endTime   String  @map("end_time")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, dayOfWeek])
  @@map("staff_schedules")
}

model Promotion {
  id              Int      @id @default(autoincrement())
  title           String
  description     String?
  discountPercent Int?     @map("discount_percent")
  startDate       String   @map("start_date")
  endDate         String   @map("end_date")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("promotions")
}
