{
  "name": "gym-management-backend",
  "version": "1.0.0",
  "description": "Gym Management System - Backend API",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "node src/prisma/seed.js",
    "db:studio": "npx prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "nodemon": "^3.1.9",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.9"
  }
}
